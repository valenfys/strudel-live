{
  "name": "strudel-live",
  "version": "1.0.0",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "build": "npm run typecheck && vite build && tsx build.ts --production",
    "build:dev": "npm run typecheck && vite build --mode development && tsx build.ts",
    "start": "npm run build:dev && ableton-extensions-cli run",
    "package": "npm run build && ableton-extensions-cli package -i dist/ui",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/draw": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "superdough": "^1.3.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
